RewriteEngine On

# Ensure HTTP Authorization header is passed to PHP FastCGI
<IfModule mod_rewrite.c>
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# 1. Forward all /api requests to local PHP proxy (connects to Node.js backend)
RewriteRule ^api/(.*)$ api-proxy.php?__api_path=$1 [QSA,L]

# 2. Allow direct access to real files and directories (images, js, css, sitemap, robots, llms)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Fallback all client-side routes to React index.html
RewriteRule ^ index.html [L]

# Gzip / Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# Browser Caching for static assets (images, fonts, scripts, css) to reduce server requests & processes
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
