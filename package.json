{
  "name": "swarada-ecommerce",
  "version": "1.0.0",
  "private": true,
  "description": "Swarada Saree Center - Premium Saree eCommerce Platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"magenta.bold,cyan.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "test:chrome": "node tests/live-chrome.test.js",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "playwright-core": "^1.65.1"
  },
  "dependencies": {
    "agent-base": "^7.1.4"
  }
}
